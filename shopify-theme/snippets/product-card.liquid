<article class="product-card"><a href="{{ product.url }}" class="product-card-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 1000px) 25vw, 50vw', alt: product.featured_image.alt | default: product.title }}{% else %}<div class="image-placeholder">{{ product.title | escape }}</div>{% endif %}{% if product.compare_at_price > product.price %}<span class="badge">Sale</span>{% endif %}</a><div class="product-card-meta"><a href="{{ product.url }}">{{ product.title | escape }}</a><span>{{ product.price | money }}</span></div></article>
