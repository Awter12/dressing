<section class="hero page-width"><div class="hero-copy"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><div class="hero-description rte">{{ section.settings.body }}</div>{% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span>↗</span></a>{% endif %}</div>{% if section.settings.image %}<div class="hero-image">{{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', widths: '700,1000,1400,2000', sizes: '(min-width: 900px) 58vw, 100vw' }}</div>{% elsif section.settings.image_url != blank %}<div class="hero-image"><img src="{{ section.settings.image_url | escape }}" alt="{{ section.settings.heading | escape }}" loading="eager"></div>{% else %}<div class="hero-image hero-placeholder"><span>AGRONOMY<br>WORKSHOP</span></div>{% endif %}</section>
{% schema %}{"name":"Editorial hero","settings":[{"type":"text","id":"kicker","label":"Eyebrow","default":"THE LONG GAME"},{"type":"text","id":"heading","label":"Heading","default":"Built for the course. Ready for everywhere."},{"type":"richtext","id":"body","label":"Text","default":"<p>Thoughtful golf apparel and accessories, designed to earn a place in your everyday rotation.</p>"},{"type":"image_picker","id":"image","label":"Upload image"},{"type":"text","id":"image_url","label":"Image URL (optional)","default":"https://framerusercontent.com/images/CULBNCNAbgtCeCAwePGc6WsCaA.png"},{"type":"text","id":"button_label","label":"Button label","default":"Explore the collection"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Editorial hero"}]}{% endschema %}
