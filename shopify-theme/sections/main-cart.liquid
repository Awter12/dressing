<section class="page-width section cart-page"><h1>Your bag</h1>{% if cart.item_count == 0 %}<p>Your bag is empty.</p><a class="button" href="{{ routes.all_products_collection_url }}">Continue shopping</a>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-lines">{% for item in cart.items %}<div class="cart-line">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: width: 120, alt: item.title }}{% endif %}<div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title | escape }}</p><label>Qty <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></label></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}</div><p class="cart-total">Subtotal <strong>{{ cart.total_price | money }}</strong></p><p>Shipping and taxes calculated at checkout.</p><button class="button" name="update">Update bag</button><button class="button" name="checkout">Checkout</button></form>{% endif %}</section>
{% schema %}{"name":"Cart","settings":[],"presets":[{"name":"Cart"}]}{% endschema %}
