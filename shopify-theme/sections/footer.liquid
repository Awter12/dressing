<footer class="site-footer"><div class="page-width footer-inner"><a class="brand" href="{{ routes.root_url }}">{{ settings.brand_name | default: shop.name | escape }}</a><p>{{ section.settings.note | escape }}</p><nav aria-label="Footer navigation">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}<a href="{{ routes.search_url }}">Search</a></nav><small>© {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ powered_by_link }}</small></div></footer>
{% schema %}{"name":"Footer","settings":[{"type":"text","id":"note","label":"Brand note","default":"Design led, functional golf apparel. Made for a life-long sport."},{"type":"link_list","id":"menu","label":"Footer menu"}],"presets":[{"name":"Footer"}]}{% endschema %}
