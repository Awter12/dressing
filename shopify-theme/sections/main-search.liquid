<section class="page-width section"><h1>Search</h1><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products"><button class="button">Search</button></form>{% if search.performed %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% else %}<p>No results found.</p>{% endfor %}</div>{% endif %}</section>
{% schema %}{"name":"Search results","settings":[],"presets":[{"name":"Search results"}]}{% endschema %}
